{
  "manifest_version": 3,
  "name": "Spectrum AI Pro Enhanced",
  "version": "3.2.1",
  "description": "Advanced AI-powered web analysis with Gemini Nano integration",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "tabGroups",
    "notifications",
    "downloads",
    "ai"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Spectrum AI Pro Enhanced",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Content Scripts/scribe.css",
        "Content Scripts/scribe-content.js",
        "chart.umd.min.js",
        "jspdf.umd.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "setup.html",
  "commands": {
    "run-audit": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Run website audit (Spectrum AI)"
    },
     "start-scribe": {
       "suggested_key": {
         "default": "Ctrl+Shift+S",
         "mac": "Command+Shift+S"
       },
       "description": "Start Scribe recording (Spectrum AI)"
     },
     "organize-tabs": {
       "suggested_key": {
         "default": "Ctrl+Shift+O",
         "mac": "Command+Shift+O"
       },
       "description": "Organize tabs with AI (Spectrum AI)"
     }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}